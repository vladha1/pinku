<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pinku</string>

    <!--
      Opens start_pinku.command in Terminal.app at login.
      Terminal.app has camera permission → Pinku inherits it.
      The .command file contains a watchdog loop so Pinku auto-restarts on crash.
      'open' returns immediately; launchd runs it once at login (RunAtLoad).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>Terminal</string>
        <string>/Users/vivekladha/pinku/start_pinku.command</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Do NOT use KeepAlive — 'open' exits immediately and KeepAlive would
         spam new Terminal windows every few seconds. -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
