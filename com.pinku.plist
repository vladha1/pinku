<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pinku</string>

    <!-- Run pinku.py directly in the user's GUI session (LaunchAgent) so it
         gets full CoreAudio access for mic input and TTS output.
         KeepAlive=true → launchd auto-restarts on crash.
         ThrottleInterval=10 → never restarts faster than every 10s. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/vivekladha/pinku/.venv/bin/python3</string>
        <string>/Users/vivekladha/pinku/pinku.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vivekladha/pinku</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Prevent rapid restart loops (e.g. if mic/model fails at startup) -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/vivekladha/Library/Logs/pinku.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vivekladha/Library/Logs/pinku.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>TF_CPP_MIN_LOG_LEVEL</key>
        <string>3</string>
        <key>GRPC_VERBOSITY</key>
        <string>ERROR</string>
    </dict>
</dict>
</plist>
